# ==============================================================================
# Configuração do ambiente — catálogo privado
# Copie este arquivo para `.env` e preencha com valores reais.
# NUNCA envie `.env` nem segredos para o repositório.
# ==============================================================================

# --- Banco de dados (SQLite) ------------------------------------------------
# O caminho é relativo à raiz do projeto.
DATABASE_URL="file:./prisma/dev.db"
# Em deploy (Render) use um diretório no disco persistente, ex.:
# DATABASE_URL="file:/var/data/prisma/dev.db"

# --- Uploads (avatars, emojis, discovery, mídia do chat) ---------------------
# Padrão local: <raiz do projeto>/public/uploads
# Em deploy (Render) aponte para o disco persistente, ex.: /var/data/uploads
# UPLOADS_ROOT="/var/data/uploads"

# --- Autenticação / sessão ---------------------------------------------------
# Gere um valor com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# URL base da aplicação (usada em links de e-mail/notificações no futuro).
APP_URL="http://localhost:3000"

# --- Usuário administrador inicial (criado pelo seed) -----------------------
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# --- emojIA (geração de emojis por IA — opcional) -----------------------------
# EMOJIA_API_URL="https://..."
# EMOJIA_API_KEY=""

# --- Busca externa na AjudaIA (opcional) ---------------------------------------
# DISCOVERY_EXTERNAL_SEARCH="0"