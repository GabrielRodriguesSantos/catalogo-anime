datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum WorkType {
  ANIME
  MANGA
  MANHWA
  MANHUA
  DONGHUA
  NOVEL
  OTHER
}

enum WorkStatus {
  ONGOING
  COMPLETED
  HIATUS
  CANCELLED
  UNKNOWN
}

enum WorkAgeRating {
  LIVRE
  R10
  R12
  R14
  R16
  R18
}

enum LibraryItemStatus {
  PLANNED
  WATCHING
  READING
  COMPLETED
  PAUSED
  DROPPED
  REWATCHING
  REREADING
}

enum ChatRoomType {
  DIRECT
  GROUP
}

enum GroupRole {
  MEMBER
  MODERATOR
  ADMIN
  OWNER
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  username     String        @unique
  passwordHash String
  role         Role          @default(USER)
  status       AccountStatus @default(ACTIVE)
  displayName  String?
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  profile          Profile?
  favorites        Favorite[]
  libraries        Library[]
  libraryItems     LibraryItem[]
  historyEntries   HistoryEntry[]
  notifications    Notification[]
  chatMemberships  ChatMembership[]
  messages         Message[]
  messageReads     MessageRead[]
  groupMemberships GroupMembership[]
  createdGroups    Group[]          @relation("GroupCreator")
  customEmojis     CustomEmoji[]
  settings         UserSetting?
  auditLogs        AuditLog[]
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String?
  avatarUrl   String?
  bannerUrl   String?
  bio         String?
  birthday    DateTime?
  location    String?
  website     String?
  theme       String?
  locale      String   @default("pt-BR")
  extras      String?
  adultVerified   Boolean   @default(false)
  adultVerifiedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Work {
  id            String     @id @default(cuid())
  type          WorkType
  title         String
  titles        String?
  synopsis      String?
  coverUrl      String?
  bannerUrl     String?
  status        WorkStatus @default(UNKNOWN)
  year          Int?
  studio        String?
  author        String?
  totalChapters Int?
  totalEpisodes Int?
  rating        Float?
  ageRating     WorkAgeRating @default(LIVRE)
  availability  String?
  language      String?
  platform      String?
  externalIds   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  genres         WorkGenre[]
  favorites      Favorite[]
  libraryItems   LibraryItem[]
  historyEntries HistoryEntry[]
  groupWorks     WorkGroup[]
  externalLinks  WorkExternalLink[]
  reviews        WorkReview[]
  sharedMessages Message[]

  @@index([type])
  @@index([status])
  @@index([title])
  @@index([language])
  @@index([platform])
}

model WorkExternalLink {
  id                String    @id @default(cuid())
  workId            String
  platform          String
  label             String?
  url               String
  country           String?
  flag              String?
  language          String?
  region            String?
  priceModel        String? // FREE | ADS | SUBSCRIPTION | VIP | PAID | UNKNOWN
  dubbingStatus     String? // ACTUAL | ANNOUNCED_FUTURE | NONE | UNKNOWN
  subtitleAvailable Boolean   @default(false)
  verified          Boolean   @default(false)
  note              String?
  lastCheckedAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId])
}

model WorkReview {
  id          String    @id @default(cuid())
  workId      String
  title       String
  kind        String // FORUM | VIDEO | COMMENT | REVIEW | COMMUNITY | OTHER
  source      String
  url         String?
  author      String?
  snippet     String?
  publishedAt DateTime?
  fetchedAt   DateTime  @default(now())
  createdAt   DateTime  @default(now())

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId])
}

model Genre {
  id   String @id @default(cuid())
  name String @unique

  works WorkGenre[]
}

model WorkGenre {
  workId  String
  genreId String
  work    Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([workId, genreId])
  @@index([genreId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  workId    String
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
  @@index([userId])
  @@index([workId])
}

model Library {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isDefault   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items LibraryItem[]

  @@unique([userId, name])
  @@index([userId])
}

model LibraryItem {
  id          String             @id @default(cuid())
  userId      String
  libraryId   String
  workId      String
  status      LibraryItemStatus? @default(PLANNED)
  progress    Int?
  score       Int?
  notes       String?
  startDate   DateTime?
  finishDate  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  work    Work    @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([libraryId, workId])
  @@index([userId, status])
  @@index([workId])
}

model HistoryEntry {
  id        String   @id @default(cuid())
  userId    String
  workId    String?
  action    String
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  work Work? @relation(fields: [workId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([workId])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  type       String
  title      String
  message    String?
  link       String?
  priority   Int       @default(0)
  readAt     DateTime?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, priority])
}

model ChatRoom {
  id        String       @id @default(cuid())
  type      ChatRoomType
  name      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  members  ChatMembership[]
  messages Message[]
}

model ChatMembership {
  roomId     String
  userId     String
  lastReadAt DateTime?
  joinedAt   DateTime @default(now())

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
}

model Message {
  id           String   @id @default(cuid())
  roomId       String
  senderId     String
  type         String   @default("TEXT")
  body         String?
  mediaUrl     String?
  mediaMime    String?
  mediaName    String?
  mediaDuration Int?
  meta         String?
  workId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  room   ChatRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  work   Work?         @relation(fields: [workId], references: [id], onDelete: SetNull)
  readBy MessageRead[]

  @@index([roomId, createdAt])
  @@index([workId])
}

model CustomEmoji {
  id        String   @id @default(cuid())
  userId    String
  name      String
  prompt    String
  imagePath String
  mime      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?
  isPrivate   Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator User        @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members GroupMembership[]
  works   WorkGroup[]

  @@index([name])
}

model GroupMembership {
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model WorkGroup {
  groupId   String
  workId    String
  addedBy   String?
  addedAt   DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  work  Work  @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@id([groupId, workId])
  @@index([workId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model AppSetting {
  key       String   @id
  value     String
  isPublic  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model UserSetting {
  userId    String   @id
  data      String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}